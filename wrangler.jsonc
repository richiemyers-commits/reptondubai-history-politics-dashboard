{
  "name": "reptondubai-history-politics-dashboard-dev",
  "compatibility_date": "2026-07-04",
  "workers_dev": true,
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  }
}
